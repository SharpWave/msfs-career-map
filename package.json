{
  "name": "msfs-career-map",
  "version": "0.8.0",
  "private": true,
  "description": "Map-centric tracker for a home-spun MSFS 2024 career mode: per-aircraft hop paths, airports and times.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch --no-warnings=ExperimentalWarning src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/server/index.ts",
    "import-airports": "tsx --no-warnings=ExperimentalWarning scripts/import-airports.ts",
    "sim-probe": "tsx --no-warnings=ExperimentalWarning scripts/sim-probe.ts",
    "sim-fake": "tsx --no-warnings=ExperimentalWarning scripts/sim-fake.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "node-simconnect": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
